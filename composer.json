{
  "name": "nugsoft/signalbridge-laravel-sdk",
  "description": "Laravel SDK for SignalBridge SMS Gateway - Send SMS messages through multiple vendors with unified API",
  "keywords": [
    "laravel",
    "sms",
    "signalbridge",
    "nugsoft",
    "messaging",
    "notifications",
    "africa-talking",
    "speedamobile"
  ],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Asaba William",
      "email": "asabawilliam@gmail.com"
    }
  ],
  "require": {
    "php": "^8.1|^8.2|^8.3|^8.4",
    "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
    "guzzlehttp/guzzle": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0|^11.0|^12.0",
    "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
    "mockery/mockery": "^1.6"
  },
  "autoload": {
    "psr-4": {
      "Nugsoft\\SignalBridge\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Nugsoft\\SignalBridge\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Nugsoft\\SignalBridge\\SignalBridgeServiceProvider"
      ],
      "aliases": {
        "SignalBridge": "Nugsoft\\SignalBridge\\Facades\\SignalBridge"
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
